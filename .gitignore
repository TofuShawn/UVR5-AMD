# local virtualenv (py -3.12, ROCm wheels are cp312-only)
.venv/

# test harness byproducts
__pycache__/
.pytest_cache/
tests/_artifacts/
tests/golden/_artifacts/

# agent planning scratch
.superpowers/

# design and plan documents are kept local by policy, like .superpowers/ -- a broad
# `git add -A` at branch end must not stage either one. Anchored with a leading `/` so
# it means this repo's top-level docs/ ONLY: an unanchored `docs/` also matched
# `lib_v5/docs/` and any vendored `*/docs/` (measured: `git check-ignore -v
# lib_v5/docs/new.md` hit this rule), silently ignoring tracked-able trees that are not
# the policy's subject.
/docs/

# `data = load_data()` is a *module-level* statement of `UVR.py`, so it is not gated by
# the raise at the top of that file: importing the module would read/write a CWD-relative
# `data.pkl` (and `UVR.py`'s own module-level `os.chdir(BASE_PATH)` makes that CWD the
# repo root). It stays unproduced only because `UVR.py` is not importable in this venv,
# which is why `UVR.py`'s comment block says "unreachable when run", not "inert" -- and
# why a stray run or a revived import must not be able to commit the file.
data.pkl

# local double-click launcher; carries this machine's weights path, so it stays out of
# the tree like the other local-only conveniences above. Anchored to the repo root.
/run.bat

# build artifact of tools/make_dist.py (the distributable source zip)
/dist/
